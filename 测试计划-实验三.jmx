        <hashTree/>
        <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="同步定时器-20线程集合点(同时开火)" enabled="true">
          <intProp name="groupSize">20</intProp>
          <longProp name="timeoutInMs">5000</longProp>
        </SyncTimer>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="updateUser-限流测试" enabled="true">
          <stringProp name="TestPlan.comments">20线程集合点同时发出PUT请求,每2秒仅5个能获得令牌(limit-for-period=5),其余15个因timeout-duration=0ms被立即拒绝,返回&quot;服务当前被限流,用户修改失败,请稍后重试&quot;</stringProp>
          <stringProp name="HTTPSampler.path">/cart/updateUser</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">PUT</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
  &quot;userId&quot;: ${__Random(1,100)},&#xd;
  &quot;userName&quot;: &quot;限流测试用户${__Random(1,1000)}&quot;,&#xd;
  &quot;userPassword&quot;: &quot;123456&quot;&#xd;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
