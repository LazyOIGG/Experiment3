      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="线程组4-限流器测试(rateLimiterA)">
        <stringProp name="TestPlan.comments">测试RateLimiter限流器: limit-refresh-period=2s, limit-for-period=5, timeout-duration=0ms。20线程集合点同时开火,仅5个获得令牌,其余15个被立即拒绝</stringProp>
        <intProp name="ThreadGroup.num_threads">20</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="循环控制器">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
